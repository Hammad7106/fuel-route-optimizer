DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Public OSRM demo server (no key needed). Point at a self-hosted OSRM in production.
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=10

VEHICLE_MAX_RANGE_MILES=500
VEHICLE_MPG=10
ROUTE_CACHE_TIMEOUT=86400

# How far from the road a station may be and still count as on the route.
STATION_SEARCH_RADIUS_MILES=10
# Only the cheapest station in each stretch of this many miles is a candidate stop.
FUEL_STOP_MERGE_MILES=25
